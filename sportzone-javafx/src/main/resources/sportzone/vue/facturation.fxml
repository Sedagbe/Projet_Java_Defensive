<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sportzone.controleur.FacturationController">
    <center>
        <GridPane alignment="CENTER" hgap="12.0" vgap="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <Label styleClass="titre" text="Facturation"
                   GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0"/>
            <Label text="Téléphone de l'adhérent :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="champTelephone" promptText="Ex : 0612345678"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Désignation :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="champDesignation" promptText="Ex : Séance de yoga"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Montant (€) :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="champMontant" promptText="Ex : 8.00"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <HBox spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                <Button onAction="#emettreFacture" text="Émettre la facture"/>
                <Button onAction="#retourAccueil" text="Accueil"/>
            </HBox>
            <Label fx:id="labelResultat" styleClass="resultat" wrapText="true"
                   GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5"/>
        </GridPane>
    </center>
</BorderPane>

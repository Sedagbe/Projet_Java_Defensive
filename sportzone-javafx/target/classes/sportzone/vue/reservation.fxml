<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sportzone.controleur.ReservationController">
    <center>
        <GridPane alignment="CENTER" hgap="12.0" vgap="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <Label styleClass="titre" text="Réservation"
                   GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0"/>
            <Label text="Séance sélectionnée :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="labelSceance" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Nom de l'adhérent :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="champNom" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Téléphone :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="champTelephone" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <HBox spacing="10.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                <Button onAction="#confirmerReservation" text="Confirmer la réservation"/>
                <Button onAction="#retourPlanning" text="Retour au planning"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>
